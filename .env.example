# Compose defaults to memory; choose dynamo only after starting and initializing DynamoDB Local.
PROVIDER_STORE=memory
# Local table and container-only endpoint for the optional dynamo profile.
DYNAMO_TABLE=
DYNAMO_ENDPOINT=
AWS_REGION=us-east-1
# Graph planning providers; each defaults to its offline mock.
# Weather: mock or wttr. Places: mock or overpass. Neither needs an account.
PROVIDER_WEATHER=mock
PROVIDER_PLACES=mock
# Events: mock or ticketmaster. LLM: mock, openai or anthropic.
PROVIDER_EVENTS=mock
PROVIDER_LLM=mock
# Model for the selected LLM only; required with that selection.
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Per-request vendor timeout in milliseconds, 100–30000; default 5000.
PROVIDER_TIMEOUT_MS=5000
# Secrets for the selected vendors only. WANDER_ names keep an unrelated exported key out.
WANDER_TICKETMASTER_API_KEY=
WANDER_OPENAI_API_KEY=
WANDER_ANTHROPIC_API_KEY=
# off sends no telemetry; otlp requires a collector origin such as http://collector:4318.
TELEMETRY_MODE=off
OTEL_EXPORTER_OTLP_ENDPOINT=
# Secret for optional New Relic collector profile; never needed for local trace viewing.
NEW_RELIC_LICENSE_KEY=
# Regional New Relic OTLP HTTP origin when selected.
NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
# Public Sentry settings embedded when the static UI image is built; blank disables it.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
# Local smoke client endpoint; default uses the GraphQL container port on the host.
GRAPHQL_URL=http://localhost:4000/graphql
