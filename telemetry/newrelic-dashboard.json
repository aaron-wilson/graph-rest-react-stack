{
  "name": "Wander service health",
  "description": "Replace every accountId: 0 with your New Relic account ID before importing. Not live verified.",
  "pages": [
    {
      "name": "API and providers",
      "widgets": [
        {
          "title": "Operation latency",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentile(wander.operation.duration, 50, 95, 99) FROM Metric TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Error logs",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) FROM Log WHERE severity.text = 'ERROR' FACET service.name TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Provider duration",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(wander.operation.duration) FROM Metric WHERE operation LIKE 'provider.%' FACET operation TIMESERIES"
              }
            ]
          }
        }
      ]
    }
  ],
  "permissions": "PUBLIC_READ_WRITE"
}
